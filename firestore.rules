rules_version = '2';

// The app never reads or writes Firestore from the browser: every read and
// write goes through the API routes (Admin SDK), which enforce roles, the
// reporting chain and workflow rules. Direct client access would bypass all
// of that (e.g. an assignee marking their own task completed, or an organizer
// skipping activity approval), so it's denied for everyone but developers.
service cloud.firestore {
  match /databases/{database}/documents {

    function isDeveloper() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "developer";
    }

    match /users/{userId} {
      // A user can read their own profile; nothing else is open to clients.
      allow read: if request.auth != null && request.auth.uid == userId;
    }

    match /{document=**} {
      allow read, write: if isDeveloper();
    }
  }
}
